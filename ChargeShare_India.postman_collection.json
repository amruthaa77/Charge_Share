{
  "info": {
    "name": "ChargeShare India - Peer-to-Peer EV Charging API",
    "_postman_id": "c1f7b8a2-7104-4e2a-8c8c-1e4284d7d3d2",
    "description": "Comprehensive Postman collection for ChargeShare India REST APIs.\nContains Auth, Vehicles, Chargers, Bookings, Payments, Reviews, Verifications, and Admin endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register EV Owner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+919876543210\",\n  \"role\": \"EV_OWNER\",\n  \"city\": \"Bengaluru\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner1@chargeshare.in\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Chargers",
      "item": [
        {
          "name": "Search Chargers (Nearby Geo)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chargers?lat=12.9716&lng=77.5946&radiusKm=25&connectorType=CCS2",
              "host": ["{{baseUrl}}"],
              "path": ["chargers"],
              "query": [
                { "key": "lat", "value": "12.9716" },
                { "key": "lng", "value": "77.5946" },
                { "key": "radiusKm", "value": "25" },
                { "key": "connectorType", "value": "CCS2" }
              ]
            }
          }
        },
        {
          "name": "Get Charger Availability",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/chargers/:id/availability?date=2025-06-15", "host": ["{{baseUrl}}"], "path": ["chargers", ":id", "availability"] }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Create Booking (Hold Slot)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chargerId\": \"65e8a9d1b4c3e80012345678\",\n  \"slotStart\": \"2025-06-15T10:00:00.000Z\",\n  \"durationMinutes\": 60\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        },
        {
          "name": "Confirm Booking (Mock/Razorpay)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"65e8a9d1b4c3e80012345678\",\n  \"isMock\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/bookings/confirm", "host": ["{{baseUrl}}"], "path": ["bookings", "confirm"] }
          }
        }
      ]
    }
  ]
}
